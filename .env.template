# Ground Station Core Environment Configuration
# Copy this file to .env and fill in your values

# Ground Station Location
GSC_LATITUDE=48.31237
GSC_LONGITUDE=7.44126
GSC_ALTITUDE=0

# API Configuration
GSC_API_HOST=127.0.0.1
GSC_API_PORT=8000

# SDR Configuration
GSC_SDR_FREQ=437000000
GSC_SDR_SAMPLE_RATE=2000000
GSC_SDR_TX_GAIN=70.0
GSC_SDR_RX_GAIN=40.0

# InfluxDB Configuration
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=gsc-super-secret-token
INFLUXDB_ORG=ground-station
INFLUXDB_BUCKET=satellite_telemetry

# Email Notification Configuration (optional)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_RECIPIENT=recipient@example.com

# Serial Port Configuration (for antenna rotator)
ANT_SERIAL_PORT=/dev/ttyUSB1  # Windows: COM3, Linux: /dev/ttyUSB1

# Logging
GSC_LOG_LEVEL=INFO
